################################################################################
#                               Immich Settings                                #
################################################################################
# These are settings specific to the Immich instance you are using.
# ---------------------------------------------------------------------------- #
# HOST — full base URL of your Immich instance.
#   (required, no trailing slash needed)
#
# TIMEZONE — IANA timezone name used when formatting dates in filenames.
#   (e.g. "date" pattern; Defaults to UTC if not set)
################################################################################
SERVER_IMMICH_HOST=https://demo.immich.app/
SERVER_IMMICH_TIMEZONE=US/Eastern

################################################################################
#                                Server Logging                                #
################################################################################
# You can toggle each log level independently. Set to false to 
# suppress that category.
# ------------------------------------------------------------------------------
#   INFO        — general lifecycle events (startup, connections, cache hits)
#   WARN        — recoverable issues worth noting
#   ERROR       — failures that affect a request or operation
#   DEBUG       — verbose internal state, useful for diagnosing problems
#   API         — structured per-request api logs (method, path, status, timing)
#   EXPLICIT    — various internal logs
#   FILESYSTEM  — per-request logs for filesystem (method, path, status, timing)
# ------------------------------------------------------------------------------
# Other options are included as follows:
# ------------------------------------------------------------------------------
#   LOGS_MAX_SESSIONS - The maximum number of session logs to store 
#                       (defaults to 10)
################################################################################
SERVER_LOGS_INFO=true
SERVER_LOGS_WARN=true
SERVER_LOGS_ERROR=true
SERVER_LOGS_DEBUG=false
SERVER_LOGS_API=false
SERVER_LOGS_EXPLICIT=false
SERVER_LOGS_FILESYSTEM=false
SERVER_LOGS_MAX_SESSIONS=10

################################################################################
#                               Server Protocols                               #
################################################################################
# These are settings specific to the server ip reservations and protocols.
# ---------------------------------------------------------------------------- #
#   HOST — Network interface the server binds to.  0.0.0.0 listens on all interfaces;
#       use a specific IP to restrict access to one network.
#
#   ALLOW - Toggle each file bridge protocol independently. Set to false to disable 
#       that specific protocol. Options:
#           SFTP   — SFTP (SSH File Transfer Protocol) support
#           WEBDAV — WebDAV (Web Distributed Authoring and Versioning) support
#
#   PORTS - Ports the protocol listeners bind to inside the container. When running 
#       via Docker, map these to host ports in your docker-compose.yml.
################################################################################
SERVER_PROTOCOL_HOST=0.0.0.0
SERVER_PROTOCOL_ALLOW_SFTP=true
SERVER_PROTOCOL_ALLOW_WEBDAV=true
SERVER_PROTOCOL_PORTS_SFTP=22
SERVER_PROTOCOL_PORTS_WEBDAV=1900

################################################################################
#                               Server Filepaths                               #
################################################################################
# These are bind-mounted into the container by docker-compose.yml.
# ---------------------------------------------------------------------------- #
#   APPDATA         ➤ /data
#       ┃ runtime data (session state, caches)
#       ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#   APPCONFIG       ➤ /config  
#       ┃ per-user config JSON files
#       ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#   IMMICH_UPLOADS  ➤ /immich/data
#       ┃ must point to your Immich upload directory; 
#       ┃ required when `SERVER_OPTION_ENABLE_LOCAL_FILES=true` so assets are 
#       ┃ read directly from disk instead of downloaded via the API.
#       ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#   LOGS            ➤ /logs
#       ┃ server log output
#       ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
################################################################################
SERVER_PATH_APPDATA="./data"
SERVER_PATH_APPCONFIG="./config"
SERVER_PATH_IMMICH_UPLOADS="/srv/immich/upload"
SERVER_PATH_LOGS="./logs"

################################################################################
#                                Server Options                                #
################################################################################
# These are options that are specific to server operation and effect all users.
# ---------------------------------------------------------------------------- #
#   ENABLE_LOCAL_FILES — when true, asset content is read directly from the
#       IMMICH_UPLOADS mount instead of being downloaded through the Immich API.
#       Requires SERVER_PATH_IMMICH_UPLOADS to be correctly mounted.  Significantly
#       reduces bandwidth and latency for large libraries on the same host.
#
#   ENABLE_UPLOAD_VALIDATION — when true, uploaded files are validated against
#       Immich before being accepted (checks that the asset exists and is accessible).
#
#   MAX_CACHE_BUFFER — maximum size of a single asset kept as an in-memory buffer
#       shared across all SFTP/WebDAV connections.  Assets larger than this threshold
#       are streamed to a per-session tmp file instead.
#       Raise this when using preview/thumbnail mode (assets are usually ≤ 2 MB) so
#       previews are cached in RAM without re-downloading.  Lower it if memory is tight.
#       Supports suffixes: B, KB, MB, GB  (e.g. "8MB")
#
#   MAX_READ_BATCH_SIZE — number of directory entries returned per SFTP READDIR reply.
#       Larger batches reduce round-trips when listing big albums; smaller batches let
#       the server interleave other requests between replies.
#
#   MAX_CONCURRENT_DOWNLOADS — maximum simultaneous asset downloads from Immich.
#       A global semaphore is shared across all connections so the total never exceeds
#       this value.  rclone mounts typically open 2–8 connections; set this to match
#       your Immich server capacity (default 10 is a safe starting point).
#
#   SHARED_BUFFER_CACHE_CAP — maximum number of asset buffers held in the shared
#       in-memory LRU cache at once.  When the limit is reached the oldest entry is
#       evicted to make room.  Works alongside MAX_CACHE_BUFFER: that setting caps the
#       byte size of each entry; this setting caps how many entries exist at all.
################################################################################
SERVER_OPTION_ENABLE_LOCAL_FILES=true
SERVER_OPTION_ENABLE_UPLOAD_VALIDATION=true
SERVER_OPTION_MAX_CACHE_BUFFER="8MB"
SERVER_OPTION_MAX_READ_BATCH_SIZE=50
SERVER_OPTION_MAX_CONCURRENT_DOWNLOADS=10
SERVER_OPTION_SHARED_BUFFER_CACHE_CAP=1000

################################################################################
#                             Server User Defaults                             #
################################################################################
# These are options that are defaults for all users and can be changed by users.
# ---------------------------------------------------------------------------- #
#   ASSET_DOWNLOAD_SOURCE — which Immich endpoint is used when reading asset content:
#       "original"  — full-resolution source file  (default; best quality)
#       "preview"   — server-transcoded preview JPEG (faster for thumbnails / rclone mounts)
#   
#       NOTE: when set to "preview" the server issues one HEAD request per asset on
#       first access to determine the preview byte-count (the original fileSizeInByte
#       from the Immich API does NOT match the transcoded preview).  Results are cached
#       per session so only the very first directory listing incurs the overhead.
#
#   ASSET_ENABLE_SIDECAR_FILES — when true, an XMP sidecar file is exposed alongside
#       each asset (e.g. photo.jpg + photo.jpg.xmp).  Useful for metadata-aware clients.
#
#   ASSET_FILEPATTERN — controls how asset filenames are constructed.  Options:
#       "original"           — use the original filename from Immich  (default)
#       "original+shortUuid" — original filename + a short unique suffix
#       "original+assetUuid" — original filename + full Immich asset UUID
#       "assetUuid"          — full Immich asset UUID only
#       "shortUuid"          — short UUID only
#       "date"               — capture date formatted as a filename
#       "dateUuid"           — capture date + full UUID
#
#   ALBUM_SUBFOLDER_PATTERN — separator inserted between nested album folder levels
#       when an album name contains a hierarchy (e.g. "Travel / 2024 / Japan").
#       Change this if your album names legitimately contain " / ".
#
#   ENABLE_ALBUM_LINKS — when true, each album folder contains a browser shortcut
#       file (.url) that opens the album directly in the Immich web UI.
#
#   ENABLE_ALBUM_METADATA — when true, each album folder contains a YAML metadata
#       file with the album's name, description, and shared users.  The file is
#       editable: saving changes writes them back to Immich.
#
#   ENABLE_TRASH_LINK — when true, the trash folder contains a browser shortcut
#       file (.url) that opens the Immich trash page in the web UI.
#
#   SERVER_USERDEFAULTS_DIGIKAM_TRASH_COMPAT - <insert a description here>
################################################################################
SERVER_USERDEFAULTS_ASSET_DOWNLOAD_SOURCE="original"
SERVER_USERDEFAULTS_ASSET_ENABLE_SIDECAR_FILES=true
SERVER_USERDEFAULTS_ASSET_FILEPATTERN="original"
SERVER_USERDEFAULTS_ALBUM_SUBFOLDER_PATTERN=" / "
SERVER_USERDEFAULTS_ENABLE_ALBUM_LINKS=true
SERVER_USERDEFAULTS_ENABLE_ALBUM_METADATA=true
SERVER_USERDEFAULTS_ENABLE_TRASH_LINK=true
SERVER_USERDEFAULTS_DIGIKAM_TRASH_COMPAT=false