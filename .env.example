# Immich Settings
IMMICH_HOST=https://demo.immich.app/
IMMICH_TIMEZONE=US/Eastern

# Server Protocols
SERVER_ENABLE_FTP=true
SERVER_ENABLE_SFTP=true
SERVER_ENABLE_WEBDAV=true

# Server Hostname
SERVER_HOST=0.0.0.0
#SERVER_HOST_FTP_PASSIVE=

# Server Ports
SERVER_PORT_FTP=21
SERVER_PORT_SFTP=22
SERVER_PORT_WEBDAV=1900
#SERVER_PORT_FTP_PASSIVE_MIN=
#SERVER_PORT_FTP_PASSIVE_MAX=

# Server Filepaths
SERVER_PATH_APPDATA="./data"
SERVER_PATH_APPCONFIG="./config"
SERVER_PATH_IMMICH_UPLOADS="/srv/immich/upload"

# Server Feature Toggles
SERVER_OPTION_ENABLE_UPLOAD_VALIDATION=true
SERVER_OPTION_ENABLE_LOCAL_FILES=true

# Server Size Settings
SERVER_OPTION_MAX_CACHE_BUFFER="4MB"
SERVER_OPTION_MAX_READ_BATCH_SIZE=50
SERVER_OPTION_MAX_CONCURRENT_DOWNLOADS=10

# Server Asset / Album Settings
SERVER_OPTION_ASSET_DOWNLOAD_SOURCE="original"
SERVER_OPTION_ASSET_FILEPATTERN="original"
SERVER_OPTION_ALBUM_SUBFOLDER_PATTERN=" / "