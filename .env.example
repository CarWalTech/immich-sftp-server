# Immich Settings
IMMICH_HOST=https://demo.immich.app/
IMMICH_TIMEZONE=US/Eastern

# Server Protocols
SERVER_ENABLE_SFTP=true
SERVER_ENABLE_WEBDAV=true

# Server Hostname
SERVER_HOST=0.0.0.0

# Server Ports
SERVER_PORT_SFTP=22
SERVER_PORT_WEBDAV=1900

# Server Filepaths
SERVER_PATH_APPDATA="./data"
SERVER_PATH_APPCONFIG="./config"
SERVER_PATH_IMMICH_UPLOADS="/srv/immich/upload"
SERVER_PATH_LOGS="./logs"

# Server Feature Toggles
SERVER_OPTION_ENABLE_UPLOAD_VALIDATION=true
SERVER_OPTION_ENABLE_LOCAL_FILES=true

# Server Size Settings
#
# MAX_CACHE_BUFFER — maximum size of a single asset that is kept as an in-memory
# buffer and shared across all SFTP/WebDAV connections.  Assets larger than this
# threshold are streamed to a per-session tmp file instead.
# Raise this when using preview/thumbnail mode (assets are usually ≤ 2 MB) so that
# previews are cached in RAM and served to every rclone/Dolphin connection without
# re-downloading.  Lower it if memory is tight.
# Supports suffixes: B, KB, MB, GB  (e.g. "8MB")
SERVER_OPTION_MAX_CACHE_BUFFER="8MB"

# MAX_READ_BATCH_SIZE — number of directory entries returned per SFTP READDIR reply.
# Larger batches reduce round-trips when listing big albums; smaller batches let the
# server interleave other requests between replies.
SERVER_OPTION_MAX_READ_BATCH_SIZE=50

# MAX_CONCURRENT_DOWNLOADS — maximum simultaneous asset downloads from Immich.
# A global semaphore is shared across all connections so the total never exceeds this.
# rclone mounts typically open 2–8 connections; set this to match your Immich server
# capacity (default 10 is a safe starting point).
SERVER_OPTION_MAX_CONCURRENT_DOWNLOADS=10

# Server Asset / Album Settings
#
# ASSET_DOWNLOAD_SOURCE — which Immich endpoint is used when reading asset content:
#   "original"  — full-resolution source file  (default; best quality)
#   "preview"   — server-transcoded preview JPEG (faster for thumbnails / rclone mounts)
#
# NOTE: when set to "preview" the server issues one HEAD request per asset on first
# access to determine the preview byte-count (the original fileSizeInByte from the
# Immich API does NOT match the transcoded preview).  Results are cached per session
# so only the very first directory listing incurs the overhead.
SERVER_OPTION_ASSET_DOWNLOAD_SOURCE="original"

SERVER_OPTION_ASSET_ENABLE_SIDECAR_FILES=true
SERVER_OPTION_ASSET_FILEPATTERN="original"
SERVER_OPTION_ALBUM_SUBFOLDER_PATTERN=" / "
