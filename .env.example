# Immich Settings
IMMICH_HOST=https://demo.immich.app/
IMMICH_UPLOAD_FOLDER="/srv/immich/upload"

# Service Configuration
ENABLE_SFTP=true
ENABLE_FTP=true
ENABLE_WEBDAV=true
SFTP_PORT=22
FTP_PORT=21
WEBDAV_PORT=1900
LISTEN_HOST=0.0.0.0

# Server Settings
TZ=US/Eastern
LOCAL_FILES_MODE=true
READ_BATCH_SIZE=256
ASSET_FILENAME_PATTERN="original"
SETTINGS_FILE_PATH=/config/{userId}.yaml