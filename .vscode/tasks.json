{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "up docker",
            "type": "shell",
            "command": "docker compose -f docker-compose.yaml up"
        },
        {
            "label": "build docker",
            "type": "shell",
            "command": "docker compose -f docker-compose.yaml up --build"
        },
        {
            "label": "down docker",
            "type": "shell",
            "command": "docker compose -f docker-compose.yaml down"
        },
        {
            "label": "remove docker",
            "type": "shell",
            "command": "docker compose -f docker-compose.yaml rm"
        },
        {
            "label": "stop docker",
            "type": "shell",
            "command": "docker compose -f docker-compose.yaml down"
        }
    ]
}