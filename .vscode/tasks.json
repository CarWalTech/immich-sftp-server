{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "docker-run: debug",
            "dependsOn": [
                "docker-compose: rm-debug",
                "docker-compose: up-debug"
            ],
        },
        {
            "label": "docker-compose: up-debug",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "command": "docker compose -f docker-compose.yml -f docker-compose.override.yml up --build --force-recreate -d",
            "presentation": {
                "close": true
            }
        },
        {
            "label": "docker-compose: rm-debug",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "command": "docker compose -f docker-compose.yml -f docker-compose.override.yml down",
            "presentation": {
                "close": true
            }
        },
        {
            "label": "docker-compose: up",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "command": "docker compose -f docker-compose.yml up"
        },
        {
            "label": "docker-compose: build",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "command": "docker compose -f docker-compose.yml build"
        },
        {
            "label": "docker-compose: down",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "command": "docker compose -f docker-compose.yml down"
        },
        {
            "label": "docker-compose: rm",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "command": "docker compose -f docker-compose.yml rm"
        }
    ]
}