{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "docker-run: debug",
            "dependsOrder": "sequence",
            "dependsOn": [
                "docker-compose: rm-debug",
                "docker-compose: up-debug"
            ],
        },
        {
            "label": "docker-compose: up-debug",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "command": "./scripts/docker-compose.sh -f docker-compose.override.yml up --build --force-recreate -d",
            "presentation": {
                "close": true
            }
        },
        {
            "label": "docker-compose: rm-debug",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "command": "./scripts/docker-compose.sh -f docker-compose.override.yml down",
            "presentation": {
                "close": true
            }
        },
        {
            "label": "docker-compose: up",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "command": "./scripts/docker-compose.sh up"
        },
        {
            "label": "docker-compose: build",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "command": "./scripts/docker-compose.sh build"
        },
        {
            "label": "docker-compose: down",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "command": "./scripts/docker-compose.sh down"
        },
        {
            "label": "docker-compose: rm",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "command": "./scripts/docker-compose.sh rm"
        },
        {
            "label": "docker-compose: logs",
            "type": "shell",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            },
            "command": "docker logs immich-file-bridge -f --since=0s"
        }
    ]
}